{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
  "名片图片已下载，可通过设备分享功能发送。": {
  "extractionState": "manual",
  "localizations": {
    "zh-Hant": {
      "stringUnit": {
        "state": "translated",
        "value": "名片圖片已下載，可透過裝置分享功能傳送。"
      }
    },
    "en": {
      "stringUnit": {
        "state": "translated",
        "value": "Card image downloaded. You can share it from your device."
      }
    },
    "es": {
      "stringUnit": {
        "state": "translated",
        "value": "Imagen descargada. Puedes compartirla desde tu dispositivo."
      }
    },
    "ja": {
      "stringUnit": {
        "state": "translated",
        "value": "名刺画像をダウンロードしました。端末から共有できます。"
      }
    },
    "ko": {
      "stringUnit": {
        "state": "translated",
        "value": "명함 이미지가 다운로드되었습니다. 기기에서 공유할 수 있습니다."
      }
    },
    "zh-Hans": {
      "stringUnit": {
        "state": "translated",
        "value": "名片图片已下载，可通过设备分享功能发送。"
      }
    }
  }
},
