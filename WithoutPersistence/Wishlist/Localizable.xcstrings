    "客户资料、行程安排与结算信息，在手机和浏览器之间保持同步。" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客户资料、行程安排与结算信息，在手机和浏览器之间保持同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客戶資料、行程安排與結算資訊，在手機和瀏覽器之間保持同步。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep customer details, trips and settlement information in sync across your phone and browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza clientes, viajes e información de liquidación entre el teléfono y el navegador."
