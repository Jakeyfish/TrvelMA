    "永久删除云端账号" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久刪除雲端帳號"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently delete cloud account"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar la cuenta en la nube definitivamente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドアカウントを完全に削除"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클라우드 계정 영구 삭제"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除云端账号"
          }
        }
      }
    },
    "将永久删除此云端账号、客户、行程、旅行社、财务记录、名片图片及关联资料，无法恢复。其他账号不受影响。" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將永久刪除此雲端帳號、客戶、行程、旅行社、財務記錄、名片圖片及關聯資料，無法復原。其他帳號不受影響。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes this cloud account, customers, trips, agencies, financial records, card images and related data. This cannot be undone. Other accounts are not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán definitivamente esta cuenta, clientes, viajes, agencias, registros financieros, imágenes de tarjetas y datos relacionados. No se puede deshacer. Otras cuentas no se verán afectadas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このクラウドアカウント、顧客、行程、旅行会社、財務記録、名刺画像と関連データを完全に削除します。元に戻せません。他のアカウントには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 클라우드 계정과 고객, 일정, 여행사, 재무 기록, 명함 이미지 및 관련 자료가 영구 삭제됩니다. 복구할 수 없으며 다른 계정에는 영향을 주지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将永久删除此云端账号、客户、行程、旅行社、财务记录、名片图片及关联资料，无法恢复。其他账号不受影响。"
          }
        }
      }
    },
    "删除账号不会自动取消 Apple 订阅，请先在系统订阅管理中取消续费。" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除帳號不會自動取消 Apple 訂閱，請先在系統訂閱管理中取消續訂。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account does not cancel Apple subscriptions. Cancel renewal in system subscription settings first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar la cuenta no cancela las suscripciones de Apple. Cancela antes la renovación en los ajustes del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除してもAppleのサブスクリプションは解約されません。先にシステムのサブスクリプション設定で更新を停止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 삭제해도 Apple 구독은 취소되지 않습니다. 먼저 시스템 구독 설정에서 갱신을 취소하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除账号不会自动取消 Apple 订阅，请先在系统订阅管理中取消续费。"
          }
        }
      }
    },
