    "本地版一次买断；云端版按月或按年订阅，最多4台设备。" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地版一次买断；云端版按月或按年订阅，最多4台设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本機版一次買斷；雲端版按月或按年訂閱，最多4台裝置。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local edition is a one-time purchase. The cloud edition offers monthly or annual subscriptions for up to 4 devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La edición local es de pago único. La edición en la nube ofrece suscripciones mensuales o anuales para hasta 4 dispositivos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカル版は買い切りです。クラウド版は月額・年額サブスクリプションで、最大4台まで利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 버전은 일회성 구매입니다. 클라우드 버전은 월간 또는 연간 구독으로 최대 4대의 기기를 지원합니다."
          }
        }
      }
    },
    "购买暂未开放，当前不会扣款。" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
