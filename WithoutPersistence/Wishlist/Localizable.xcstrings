    "航班查询由云端安全代理处理，无需在浏览器保存飞友密钥。" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "航班查询由云端安全代理处理，无需在浏览器保存飞友密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "航班查詢由雲端安全代理處理，無須在瀏覽器儲存飛友金鑰。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flight queries use a secure cloud proxy. No VariFlight key needs to be stored in your browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las consultas de vuelos usan un proxy seguro en la nube. No es necesario guardar una clave de VariFlight en el navegador."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "便の検索はクラウドの安全なプロキシで処理されます。ブラウザにVariFlightのキーを保存する必要はありません。"
          }
