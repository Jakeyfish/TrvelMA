    "本地注册账号保存在此设备" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts are stored on this device"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas registradas localmente se guardan en este dispositivo"
