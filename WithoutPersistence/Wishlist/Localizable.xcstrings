          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "註冊驗證後的14天試用不綁定付款方式，到期不會自動扣款。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The 14-day trial after registration verification requires no payment method and will not charge you automatically when it ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba de 14 días tras verificar el registro no requiere un método de pago ni realiza cargos automáticos al finalizar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
